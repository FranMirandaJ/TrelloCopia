{
  // --- ESLint (solo linting; el formato lo hace Prettier) ---
  "eslint.useFlatConfig": true,
  "eslint.run": "onType",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // --- TypeScript: usar la versión del proyecto ---
  "js/ts.tsdk.path": "node_modules/typescript/lib",

  // --- Tailwind v4: ignora directivas (@theme, @apply, etc.) en globals.css ---
  "css.lint.unknownAtRules": "ignore",

  // --- Consistencia de archivo (evita conflictos en Windows/Linux) ---
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "editor.tabSize": 2,
  "editor.detectIndentation": false
}
